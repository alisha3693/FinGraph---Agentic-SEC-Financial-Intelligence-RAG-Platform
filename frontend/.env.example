# Copy to frontend/.env for local dev, or set in Vercel: Project Settings → Environment Variables.
# Vite inlines this at BUILD time — after changing it, redeploy (or run `npm run build` again).

# Base URL of the FastAPI backend, with no trailing slash.
# Local: http://localhost:8000    Deployed: your Render backend URL
VITE_API_URL=https://your-backend.onrender.com
