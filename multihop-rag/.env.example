# Copy to .env (local) or set these in your host's dashboard (Render). Never commit real values.

# REQUIRED — the server refuses to start without it.
GROQ_API_KEY=your_groq_api_key

# REQUIRED — real, monitored contact. SEC EDGAR blocks placeholder/example.com addresses.
# Format: "YourAppName your-real-email@example.com"
SEC_USER_AGENT="FinGraph your-real-email@example.com"

# Optional — comma-separated browser origins allowed by CORS, no trailing slashes.
# Defaults already include localhost:5173 and the Vercel app. Add your own here if it changes.
FRONTEND_ORIGINS=https://fin-graph-agentic-sec-financial-int.vercel.app,http://localhost:5173

# Optional — Groq model (default: qwen/qwen3.8-27b).
# GROQ_MODEL=qwen/qwen3.8-27b

# Optional — sentence-transformers model for Chroma embeddings (default: all-MiniLM-L6-v2).
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional — external consumer-data provider. Unset = consumer questions use filing search.
# EXTERNAL_DATA_URL=

# Optional — set by the host (Render sets PORT automatically). Local default is 8000.
# PORT=8000

# Optional — RELOAD=1 enables uvicorn --reload for local code editing only. Keep off in production.
# RELOAD=
